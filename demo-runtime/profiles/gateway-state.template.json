    ],
    "yuanbao": [
      "web",
      "file",
      "skills_readonly",
      "cronjob",
      "email_queue",
      "demo_home",
      "local_media"
    ]
  },
  "platforms": {
    "email": {
      "gateway_restart_notification": false,
      "home_channel": {
        "chat_id": {
          "$binding": "gateway-state.platforms.email.home_channel.chat_id"
        },
        "name": "Default email recipients",
        "platform": "email"
      }
    },
    "weixin": {
      "enabled": false
    }
  },
  "plugins": {
    "enabled": [
      "demo-home",
      "demo-media",
      "email-queue",
      "general-voice",
      "local-igpu-asr"
    ]
  },
  "prompt_caching": {
    "cache_ttl": "5m"
  },
  "providers": {
    "custom": {
      "api_key": {
        "$binding": "gateway-state.providers.custom.api_key"
      },
      "base_url": "http://localhost:8000/v3",
      "default_model": "qwen3.6-35b-a3b",
      "request_timeout_seconds": 90,
      "stale_timeout_seconds": 90
    }
  },
  "runtime": {
    "nofile_soft_limit": 4096
  },
  "session_reset": {
    "at_hour": 4,
    "idle_minutes": 1440,
    "mode": "none"
  },
  "skills": {
    "creation_nudge_interval": 15,
    "disabled": [
      "airtable",
      "architecture-diagram",
      "arxiv",
      "ascii-video",
      "baoyu-infographic",
      "blocked-page-recovery",
      "box",
      "claude-code",
      "claude-design",
      "codebase-inspection",
      "codex",
      "competitor-news-monitor",
      "computer-use",
      "design-md",
      "dogfood",
      "email-inbox-triage",
      "gif-search",
      "github",
      "google-workspace",
      "grounded-citations",
      "hermes-agent",
      "hermes-agent-skill-authoring",
      "himalaya",
      "humanizer",
      "inspecting-hermes-desktop-dom",
      "llm-wiki",
      "manim-video",
      "maps",
      "node-inspect-debugger",
      "notion",
      "obsidian",
      "opencode",
      "p5js",
      "popular-web-designs",
      "powerpoint",
      "product-price-monitor",
      "python-debugpy",
      "requesting-code-review",
      "simplify-code",
      "songsee",
      "songwriting-and-ai-music",
      "spike",
      "systematic-debugging",
      "teams-meeting-pipeline",
      "test-driven-development",
      "xurl",
      "youtube-content",
      "document-to-action-items",
      "meeting-action-items",
      "weekly-review-planning",
      "docx",
      "pdf",
      "xlsx"
    ]
  },
  "streaming": {
    "enabled": false
  },
  "stt": {
    "enabled": true,
    "language": "en",
    "local": {
      "language": "en",
      "logprob_threshold": -1.0,
      "model": "large-v3-turbo",
      "no_speech_prob_threshold": 0.6,
      "prewarm": true,
      "unload_after_idle_seconds": 0,
      "vad": true,
      "vad_min_silence_ms": 500
    },
    "openai": {
      "language": "",
      "model": "whisper-1"
    },
    "openvino_igpu": {
      "socket": "/ipc/asr/asr.sock",
      "timeout": 30
    },
    "provider": "openvino_igpu"
  },
  "telemetry": {
    "shared_metrics": {
      "enabled": false
    }
  },
  "terminal": {
    "backend": "local",
    "container_cpu": 1,
    "container_disk": 51200,
    "container_memory": 5120,
    "container_persistent": true,
    "cwd": ".",
    "docker_mount_cwd_to_workspace": false,
    "home_mode": "auto",
    "lifetime_seconds": 300,
    "timeout": 180
  },
  "tool_loop_guardrails": {
    "hard_stop_after": {
      "exact_failure": 2,
      "idempotent_no_progress": 2,
      "same_tool_failure": 2
    },
    "hard_stop_enabled": true,
    "warn_after": {
      "exact_failure": 1,
      "idempotent_no_progress": 1,
      "same_tool_failure": 1
    },
    "warnings_enabled": true
  },
  "tools": {
    "tool_search": {
      "enabled": "off"
    }
  },
  "travel_voice": {
    "default_recipient": {
      "$binding": "gateway-state.travel_voice.default_recipient"
    },
    "enabled": false
  },
  "tts": {
    "piper": {
      "voice": "zh_CN-huayan-medium",
      "voices_dir": {
        "$binding": "gateway-state.tts.piper.voices_dir"
      }
    },
    "provider": "kokoro-zh",
    "providers": {
      "kokoro-zh": {
        "command": "/opt/hermes/core-env/bin/python /opt/hermes/app/scripts/local-ovms/kokoro_client.py --socket /ipc/tts/tts.sock --input {input_path} --output {output_path} --english-voice af_maple --speed {speed}",
        "max_text_length": 500,
        "output_format": "wav",
        "speed": 1.0,
        "type": "command"
      }
    }
  },
  "updates": {
    "backup_keep": 5,
    "non_interactive_local_changes": "stash",
    "pre_update_backup": false
  },
  "voice": {
    "auto_tts": true,
    "barge_in": true,
    "beep_enabled": true,
    "clarify": {
      "enabled": true,
      "followup_timeout_seconds": 30,
      "playback_timeout_seconds": 120
    },
    "end_phrase": {
      "enabled": true,
      "hint_file": null,
      "phrase": "thank you"
    },
    "followup": {
      "enabled": false,
      "playback_timeout_seconds": 120,
      "resume_seconds": 120,
      "timeout_seconds": 30
    },
    "max_recording_seconds": 120,
    "ready_cue": {
      "enabled": true,
      "intro_enabled": true,
      "intro_text": "After the tone, you can answer directly.",
      "pre_gap_seconds": 0.65
    },
    "record_key": "ctrl+b",
    "scenes": {
      "enabled": true
    },
    "sentence_pipeline": {
      "enabled": true
    },
    "silence_duration": 4.0,
    "silence_threshold": 500,
    "startup_cue_file": "/opt/hermes/resources/box-voice/standby.wav",
    "stop_phrases": [
      "stop"
    ],
    "submit_mode": "direct",
    "thinking_sound": false,
    "tool_ack": {
      "cache_audio": true,
      "enabled": true,
      "phrases": {
        "en": [
          "Sure, let me check."
        ]
      },
      "timing": "turn_start"
    },
    "wake_ack": {
      "enabled": true,
      "text": "Hi, I'm here."
    }
  },
  "voice_delivery": {
    "continuity": {
      "enabled": false
    },
    "default_recipient": {
      "$binding": "gateway-state.voice_delivery.default_recipient"
    },
    "enabled": false
  },
  "wake_word": {
    "capture": "local",
    "confirmation_frames": 2,
    "enabled": true,
    "input_device": "pipewire",
    "phrase": "Hello Intel",
    "profile_routing": false,
    "provider": "sherpa",
    "sensitivity": 0.3,
    "sherpa": {
      "aliases": [
        "Hi Intel",
        "High Intel",
        "Hi Inter",
        "Hello Inter",
        "Hello Indel",
        "Hey Intel",
        "Hey Inter",
        "Hey Indel"
      ],
      "keywords_threshold": 0.03,
      "max_active_paths": 16,
      "model_dir": "/opt/hermes/resources/wakewords/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01"
    },
    "start_new_session": false,
    "surface": "cli"
  },
  "web": {
    "search_backend": "brave-free"
  }
}
