{
  "name": "${PROJECT}",
  "services": {
    "aisp-wake": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "--device",
        "GPU",
        "--config",
        "/config/wake/config.yaml"
      ],
      "devices": [
        {
          "source": "/dev/dri",
          "target": "/dev/dri",
          "permissions": "rwm"
        }
      ],
      "entrypoint": null,
      "environment": {
        "PIPEWIRE_REMOTE": "pipewire-0",
        "XDG_RUNTIME_DIR": "/audio"
      },
      "group_add": [
        "${VIDEO_GID}",
        "${RENDER_GID}"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python3",
          "-c",
          "from pathlib import Path; assert Path('/ipc/wake/service.sock').is_socket()"
        ],
        "timeout": "2s",
        "interval": "3s",
        "retries": 30,
        "start_period": "1m0s"
      },
      "image": "sha256:54443217692aedb8b763280856edb009e459e1b5d18f9147f5c1c4dbe6d52b4f",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "5m"
        }
      },
      "network_mode": "none",
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:size=256m,mode=1777"
      ],
      "user": "${UID}:${GID}",
      "volumes": [
        {
          "type": "bind",
          "source": "${AUDIO_RUNTIME}/pipewire-0",
          "target": "/audio/pipewire-0",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${RUNTIME}/ipc/wake",
          "target": "/ipc/wake",
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${MODELS}/wake-asr",
          "target": "/models/qwen3-asr",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${RUNTIME}/config/wake",
          "target": "/config/wake",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ]
    },
